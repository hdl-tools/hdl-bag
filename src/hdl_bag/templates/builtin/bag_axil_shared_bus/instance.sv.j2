{#- Instantiation of bag_axil_shared_bus. Context: hdl_bag.gen.wrapper.render_instance. -#}
{% set t = pkg ~ "::" ~ p %}
{% set ms = inst.masters %}
{% set ss = inst.slaves %}
  // {{ fabric.name }}: AXI4-Lite shared bus, {{ fabric.arbitration }}
  bag_axil_shared_bus #(
      .AddrWidth    ({{ fabric.addr_width }}),
      .DataWidth    ({{ t }}DataWidth),
      .NoMasters    ({{ t }}NoMasters),
      .NoSlaves     ({{ t }}NoSlaves),
      .NoRules      ({{ t }}NoRules),
      .NoAliases    ({{ t }}NoAliases),
      .MaxMstTrans  ({{ t }}MaxMstTrans),
      .MaxSlvTrans  ({{ t }}MaxSlvTrans),
      .FixedPrio    (1'b{{ 1 if fabric.arbitration == "fixed-priority" else 0 }}),
      .Priority     ({{ t }}Priority),
      .FifoDepth    ({{ t }}FifoDepth),
      .CutStages    ({{ t }}CutStages),
      .RuleBase     ({{ t }}RuleBase),
      .RuleMask     ({{ t }}RuleMask),
      .RuleSlave    ({{ t }}RuleSlave),
      .RuleNoRead   ({{ t }}RuleNoRead),
      .RuleNoWrite  ({{ t }}RuleNoWrite),
      .RuleSecure   ({{ t }}RuleSecure),
      .Connect      ({{ t }}Connect),
      .MstNoRead    ({{ t }}MstNoRead),
      .MstNoWrite   ({{ t }}MstNoWrite),
      .MissToDefault({{ t }}MissToDefault),
      .DefaultSlave ({{ t }}DefaultSlave),
      .MissResp     ({{ t }}MissResp),
      .AliasMaster  ({{ t }}AliasMaster),
      .AliasBase    ({{ t }}AliasBase),
      .AliasMask    ({{ t }}AliasMask),
      .AliasTo      ({{ t }}AliasTo)
  ) {{ name }} (
      .clk_i      ({{ ctx.clk(fabric.domain) }}),
      .rst_ni     ({{ ctx.rst(fabric.domain) }}),
      .alias_en_i ({{ ctx.alias_en() }}),
      .s_awaddr_i ({{ ctx.vec("s_awaddr", ms, "awaddr", "in") }}),
      .s_awprot_i ({{ ctx.vec("s_awprot", ms, "awprot", "in") }}),
      .s_awvalid_i({{ ctx.vec("s_awvalid", ms, "awvalid", "in") }}),
      .s_awready_o({{ ctx.vec("s_awready", ms, "awready", "out") }}),
      .s_wdata_i  ({{ ctx.vec("s_wdata", ms, "wdata", "in") }}),
      .s_wstrb_i  ({{ ctx.vec("s_wstrb", ms, "wstrb", "in") }}),
      .s_wvalid_i ({{ ctx.vec("s_wvalid", ms, "wvalid", "in") }}),
      .s_wready_o ({{ ctx.vec("s_wready", ms, "wready", "out") }}),
      .s_bresp_o  ({{ ctx.vec("s_bresp", ms, "bresp", "out") }}),
      .s_bvalid_o ({{ ctx.vec("s_bvalid", ms, "bvalid", "out") }}),
      .s_bready_i ({{ ctx.vec("s_bready", ms, "bready", "in", 1) }}),
      .s_araddr_i ({{ ctx.vec("s_araddr", ms, "araddr", "in") }}),
      .s_arprot_i ({{ ctx.vec("s_arprot", ms, "arprot", "in") }}),
      .s_arvalid_i({{ ctx.vec("s_arvalid", ms, "arvalid", "in") }}),
      .s_arready_o({{ ctx.vec("s_arready", ms, "arready", "out") }}),
      .s_rdata_o  ({{ ctx.vec("s_rdata", ms, "rdata", "out") }}),
      .s_rresp_o  ({{ ctx.vec("s_rresp", ms, "rresp", "out") }}),
      .s_rvalid_o ({{ ctx.vec("s_rvalid", ms, "rvalid", "out") }}),
      .s_rready_i ({{ ctx.vec("s_rready", ms, "rready", "in", 1) }}),
      .m_awaddr_o ({{ ctx.vec("m_awaddr", ss, "awaddr", "out") }}),
      .m_awprot_o ({{ ctx.vec("m_awprot", ss, "awprot", "out") }}),
      .m_awvalid_o({{ ctx.vec("m_awvalid", ss, "awvalid", "out") }}),
      .m_awready_i({{ ctx.vec("m_awready", ss, "awready", "in", 1) }}),
      .m_wdata_o  ({{ ctx.vec("m_wdata", ss, "wdata", "out") }}),
      .m_wstrb_o  ({{ ctx.vec("m_wstrb", ss, "wstrb", "out") }}),
      .m_wvalid_o ({{ ctx.vec("m_wvalid", ss, "wvalid", "out") }}),
      .m_wready_i ({{ ctx.vec("m_wready", ss, "wready", "in", 1) }}),
      .m_bresp_i  ({{ ctx.vec("m_bresp", ss, "bresp", "in") }}),
      .m_bvalid_i ({{ ctx.vec("m_bvalid", ss, "bvalid", "in") }}),
      .m_bready_o ({{ ctx.vec("m_bready", ss, "bready", "out") }}),
      .m_araddr_o ({{ ctx.vec("m_araddr", ss, "araddr", "out") }}),
      .m_arprot_o ({{ ctx.vec("m_arprot", ss, "arprot", "out") }}),
      .m_arvalid_o({{ ctx.vec("m_arvalid", ss, "arvalid", "out") }}),
      .m_arready_i({{ ctx.vec("m_arready", ss, "arready", "in", 1) }}),
      .m_rdata_i  ({{ ctx.vec("m_rdata", ss, "rdata", "in") }}),
      .m_rresp_i  ({{ ctx.vec("m_rresp", ss, "rresp", "in") }}),
      .m_rvalid_i ({{ ctx.vec("m_rvalid", ss, "rvalid", "in") }}),
      .m_rready_o ({{ ctx.vec("m_rready", ss, "rready", "out") }})
  );
